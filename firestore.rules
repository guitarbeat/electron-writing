rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny: No direct client-side access
    match /{document=**} {
      allow read, write: if false;
    }
    
    // Note: The application uses a server-side API to interact with Firestore.
    // The server-side code handles authentication via a shared passcode.
    // Ensure the server-side environment has appropriate credentials.
  }
}
