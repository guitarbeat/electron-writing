# Shared passcode for the private gate.
PASSCODE="0000"

# Secret used to sign the HTTP-only session cookie.
# Set this to a long random value in Vercel.
SESSION_SECRET="replace-with-a-long-random-string"

# PostgreSQL connection string from Neon. Prefer the pooled URL on Vercel.
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# Optional fallback used by Vercel/Neon integrations.
POSTGRES_URL="postgresql://user:password@host/db?sslmode=require"

# Optional pool sizing override for serverless environments.
DATABASE_POOL_MAX="5"
