# Shared passcode for the private gate and session signing.
PASSCODE="0000"

# PostgreSQL connection string from Neon. Prefer the pooled URL on Vercel.
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# Optional fallback used by Vercel/Neon integrations.
POSTGRES_URL="postgresql://user:password@host/db?sslmode=require"

# Optional pool sizing override for serverless environments.
DATABASE_POOL_MAX="5"
