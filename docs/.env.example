# ==========================================
# Smeemo Environment Variables Guide
# ==========================================
# This file provides operational guidance for configuring your deployment.
# Copy this content to a `.env.local` file for local development.
# Do NOT commit `.env.local` to version control.

# ------------------------------------------
# Authentication
# ------------------------------------------
# Shared passcode for the private gate and session signing.
# Choose a secure string (e.g., a PIN or passphrase) to protect your application.
PASSCODE="YOUR_SECURE_PASSCODE_HERE"

# ------------------------------------------
# Database Connection (Neon PostgreSQL)
# ------------------------------------------
# Provide the connection string for your database.
# On Vercel, prefer using the Neon *pooled* connection string to prevent connection limits.
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# Optional: Vercel/Neon integrations sometimes populate POSTGRES_URL.
# Smeemo will automatically fall back to this variable if DATABASE_URL is missing.
# POSTGRES_URL="postgresql://user:password@host/db?sslmode=require"

# Optional: Customize the maximum number of connections for the connection pool.
# For serverless environments like Vercel, a lower limit (e.g., 5) is recommended.
# DATABASE_POOL_MAX="5"
